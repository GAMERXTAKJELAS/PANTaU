{
  "name": "pantau",
  "main": "cloudflare_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantau-database",
      "database_id": "24c9c89a-8331-48d9-a489-dfa21ba51ae6"
    }
  ],
  "observability": {
    "enabled": true
  }
}
